# Wanderly — example environment file.
# Copy to `.env` for local development. NEVER commit the real `.env`.
#
# These keys are read on the SERVER only (inside server functions in src/lib/*.functions.js),
# so they are never bundled into the browser JavaScript.

OPENWEATHER_API_KEY=your_openweather_key
UNSPLASH_ACCESS_KEY=your_unsplash_access_key

# Used by the AI travel assistant + itinerary generator.
LOVABLE_API_KEY=your_ai_gateway_key
